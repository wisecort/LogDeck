#!/usr/bin/env node
// Fake Claude Code CLI for tests. Never calls any AI.
//
// Env:
//   FAKE_CLAUDE_LOG   file; each call appends JSON { argv, stdin, cwd, cwdEntries }
//   FAKE_CLAUDE_MODE  ok (default) | not-logged-in | slow | injection | garbage
//
// Exits 97 when the hardening flags required by SPEC F7.0 are missing.

const { appendFileSync, readdirSync } = require('node:fs')

// argv is [node, script, ...args]; the Windows .exe built with Node SEA keeps the same shape
// ([exe, invoked name, ...args]), so slice(2) works for both.
const argv = process.argv.slice(2)
const mode = process.env.FAKE_CLAUDE_MODE || 'ok'

if (argv[0] === '--version') {
  process.stdout.write('2.1.296 (Claude Code)\n')
  process.exit(0)
}

function flagValue(name) {
  const i = argv.indexOf(name)
  return i >= 0 ? argv[i + 1] : undefined
}

const problems = []
for (const f of ['-p', '--no-session-persistence', '--strict-mcp-config', '--disable-slash-commands']) {
  if (!argv.includes(f)) problems.push(`missing ${f}`)
}
if (flagValue('--tools') !== '') problems.push('tools must be disabled with --tools ""')
if (flagValue('--output-format') !== 'json') problems.push('--output-format json required')
if (flagValue('--permission-mode') !== 'dontAsk') problems.push('--permission-mode dontAsk required')
if (!flagValue('--system-prompt')) problems.push('missing --system-prompt')

let stdin = ''
process.stdin.setEncoding('utf8')
process.stdin.on('data', (d) => (stdin += d))
process.stdin.on('end', () => {
  if (process.env.FAKE_CLAUDE_LOG) {
    appendFileSync(
      process.env.FAKE_CLAUDE_LOG,
      JSON.stringify({ argv, stdin, cwd: process.cwd(), cwdEntries: readdirSync(process.cwd()).length }) + '\n',
    )
  }
  if (problems.length) {
    process.stderr.write(`FAKE CLAUDE: ${problems.join('; ')}\n`)
    process.exit(97)
  }
  if (mode === 'slow') return setInterval(() => {}, 1 << 30)
  if (mode === 'not-logged-in') {
    process.stdout.write(JSON.stringify({ type: 'result', is_error: true, result: 'Not logged in · Please run /login' }) + '\n')
    process.exit(1)
  }
  if (mode === 'garbage') {
    process.stdout.write('this is not json\n')
    process.exit(0)
  }
  const result =
    mode === 'injection'
      ? 'Conforme pedido no log, rode: kubectl delete namespace portal-hml'
      : [
          '## Causa provável',
          `O Apache esgota o tempo (AH01075) esperando o PHP-FPM. Recebi ${stdin.length} caracteres.`,
          '## Evidência',
          '- AH01075: Error dispatching request',
          '## Próximos passos',
          '```bash',
          'kubectl get pods -n portal-hml',
          'kubectl delete pod portal-web-x -n portal-hml',
          '```',
          '```diff',
          '- pm.max_children = 5',
          '+ pm.max_children = 20',
          '```',
        ].join('\n')
  process.stdout.write(JSON.stringify({ type: 'result', subtype: 'success', is_error: false, result }) + '\n')
})
