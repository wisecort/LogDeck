#!/usr/bin/env node
// Fake macOS `security` for tests: a JSON file stands in for the Keychain.
// Env: FAKE_SECURITY_STORE (path to the JSON file), FAKE_SECURITY_LOG (argv log).
const { appendFileSync, existsSync, readFileSync, writeFileSync } = require('node:fs')

// argv is [node, script, ...args]; the Windows .exe built with Node SEA keeps the same shape
// ([exe, invoked name, ...args]), so slice(2) works for both.
const argv = process.argv.slice(2)
const file = process.env.FAKE_SECURITY_STORE
if (process.env.FAKE_SECURITY_LOG) appendFileSync(process.env.FAKE_SECURITY_LOG, JSON.stringify(argv) + '\n')
const store = file && existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : {}
const flag = (name) => {
  const i = argv.indexOf(name)
  return i >= 0 ? argv[i + 1] : undefined
}
const key = `${flag('-a')}::${flag('-s')}`

switch (argv[0]) {
  case 'find-generic-password':
    if (!(key in store)) {
      process.stderr.write('security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain.\n')
      process.exit(44)
    }
    process.stdout.write(store[key] + '\n')
    process.exit(0)
  case 'add-generic-password':
    store[key] = flag('-w')
    writeFileSync(file, JSON.stringify(store))
    process.exit(0)
  case 'delete-generic-password':
    if (!(key in store)) process.exit(44)
    delete store[key]
    writeFileSync(file, JSON.stringify(store))
    process.exit(0)
  default:
    process.stderr.write(`FAKE SECURITY: unsupported ${argv.join(' ')}\n`)
    process.exit(96)
}
