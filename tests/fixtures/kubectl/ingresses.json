{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "metadata": { "name": "portal-web" },
      "spec": {
        "tls": [{ "hosts": ["portal.example.internal"] }],
        "rules": [
          {
            "host": "portal.example.internal",
            "http": { "paths": [{ "path": "/", "pathType": "Prefix", "backend": { "service": { "name": "portal-web", "port": { "number": 80 } } } }] }
          },
          {
            "host": "status.example.internal",
            "http": { "paths": [{ "path": "/health", "backend": { "service": { "name": "portal-worker", "port": { "name": "metrics" } } } }] }
          }
        ]
      }
    }
  ]
}
