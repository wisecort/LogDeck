{
  "name": "logdeck",
  "productName": "LogDeck",
  "version": "1.4.0",
  "description": "Log explorer de Kubernetes para macOS (somente leitura)",
  "private": true,
  "license": "MIT",
  "author": "Matheus Corteletti (Wise)",
  "repository": "github:wisecort/LogDeck",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "electron-builder --mac --dir --publish never",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "guardrails": "node scripts/guardrails.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "harness": "bash scripts/harness.sh",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "release:mac": "electron-builder --mac --publish never",
    "package:linux": "electron-builder --linux --dir --publish never",
    "package:win": "electron-builder --win --dir --publish never",
    "release:linux": "electron-builder --linux --publish never",
    "release:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.wisecort.logdeck",
    "productName": "LogDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "dmg": {
      "title": "LogDeck ${version}"
    },
    "artifactName": "LogDeck-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Matheus Corteletti <61605704+wisecort@users.noreply.github.com>",
      "synopsis": "Explorador de logs de Kubernetes/OKD (somente leitura)",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LogDeck"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@tanstack/react-virtual": "3.14.17",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "homepage": "https://github.com/wisecort/LogDeck"
}
